rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Projects collection: anyone can read, only authenticated admin can write/create/delete
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Teams collection: public can create team selection via atomic transaction or valid form, 
    // public can query by referenceId, admin has full access
    match /teams/{teamId} {
      allow read: if true;
      allow create: if true;
      allow update: if true; // Allows task progress updates
      allow delete: if request.auth != null;
      
      match /screenshots/{scrId} {
        allow read, create, update: if true;
        allow delete: if request.auth != null;
      }
    }

    // Selections audit log
    match /projectSelections/{selectionId} {
      allow read, create: if true;
      allow write, delete: if request.auth != null;
    }
    
    // Admin user records
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }
  }
}
